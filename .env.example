# Copy to .env and fill in the values for your printer. Never commit .env.
WMP_PRINTER=printer.example.local
WMP_USER=printer-user
WMP_PASS=replace-me
# Prefer adding the printer to ~/.ssh/known_hosts. Set to 1 only if you accept
# trusting the first host key presented by the configured address.
WMP_SSH_AUTO_ADD=0
